# Copy to deploy/.env (git-ignored) and fill in for the app-machine host. Placeholders only.
# One file holds every plain setting (owner decision 11, 2026-11-21); keys and secrets stay as
# files under deploy/secrets/. A changed value applies with `docker compose up -d` (restart).
# Committed files reference these names as ${NAME}; an unset one stops the service that needs
# it with a message naming it. `<app-machine address>` is the host's LAN address everywhere it
# appears below.
DBIG_VERSION=0.1.0
# Where the images come from. Leave empty to build from this clone (`--build` / the build step
# in DEPLOY.md); set to the registry path to pull tagged images (owner decision 8), for example
# the GitHub container registry of the project.
DBIG_REGISTRY=
# The host's LAN address: every published port binds here only (report Part 3.3, L1).
# The 192.0.2.x addresses are placeholders (TEST-NET-1): replace every one with the
# app-machine address and its network (owner decision 1: no real address in a committed file).
LAN_IP=192.0.2.10
LAN_CIDR=192.0.2.0/24
LAN_INTERFACE=eth0
# The compose network and one fixed address per service (private_base_url takes IP literals).
DBIG_SUBNET=172.30.0.0/24
# The compose network's bridge interface (15 characters at most); kept for the firewall rules,
# which are not applied for now (owner decision 2, 2026-11-21: LAN, no firewall for now).
DBIG_BRIDGE=dbig0
COLLECTOR_IP=172.30.0.10
BUILDER_IP=172.30.0.11
REQUESTER_IP=172.30.0.12
PLANNER_IP=172.30.0.13
CONTRACTS_IP=172.30.0.14
# Published ports of the five services (app-machine's LAN callers use these).
COLLECTOR_PORT=8441
BUILDER_PORT=8442
REQUESTER_PORT=8443
PLANNER_PORT=8444
CONTRACTS_PORT=8445
# Plain HTTP for the five services and the vLLM call on the LAN (owner decisions 12 and 14,
# 2026-11-21: "we don't need https for now"), and plain database connections for sources with
# tls = false (owner 2026-11-22, answer A1); C5 review 2027-05-21. Keep this at 1 on
# app-machine; with the flag set the services still refuse a public bind and a public endpoint.
DBIG_ALLOW_PLAIN_LAN=1
# The private vLLM machine (decision 3: address, model and key are settings, never fixed).
# The address is an IP literal (placeholder below); the key is secrets/model.key, never here.
VLLM_BASE_URL=http://192.0.2.30:8000/v1
VLLM_MODEL=<model name the server serves>
VLLM_MODEL_DIGEST=<sha256 digest of the model revision you pinned; changes with the model>
# The databases are not listed here: they are in deploy/sources.toml (template
# sources.example.toml, owner 2026-11-22, answer B1), with one login file per database in
# secrets/sources/. Plain database connections need DBIG_ALLOW_PLAIN_LAN=1 above (answer A1).
# Self-hosted Langfuse (decision 4): the web address the services send metadata traces to,
# and the secrets/langfuse-*.key pair. Unset URL (or keys absent) turns tracing off and nothing
# else changes; telemetry must never block the catalogue. Replace the placeholder address.
LANGFUSE_URL=http://192.0.2.10:3000
LANGFUSE_PORT=3000
# The Langfuse stack's own secrets (compose.langfuse.yaml). These have no *_FILE form in
# Langfuse, so they live here, not in secrets/. Generate once per deployment. The three
# passwords go inside DATABASE_URL, so keep them URL-safe (hex, not base64: base64 carries
# `+/=` and Prisma refuses the URL; measured on the laptop rehearsal 2026-11-22):
#   LANGFUSE_ENCRYPTION_KEY, the passwords: openssl rand -hex 24
#   LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT: openssl rand -base64 32 (read as plain env,
#   never inside a URL)
LANGFUSE_NEXTAUTH_SECRET=<generated>
LANGFUSE_SALT=<generated>
LANGFUSE_ENCRYPTION_KEY=<generated>
LANGFUSE_DB_PASSWORD=<generat…d>
LANGFUSE_CH_PASSWORD=<generat…d>
LANGFUSE_REDIS_PASSWORD=<genera…d>
LANGFUSE_S3_SECRET=<genera…d>
# Outbound targets the docs list for the (unused-for-now) firewall: databases, vLLM, Langfuse
# (ip:port, comma-separated; placeholders, same rule as LAN_IP). These values are pinned by the
# captured chain in tests/test_lan_boundary_check.py (T7): change them there together, never here
# alone. A deployment with extra targets (for example Langfuse) adds them at apply time on the
# host; the committed list is what --print and T7 compare.
DBIG_EGRESS=192.0.2.20:5432,192.0.2.21:9440,192.0.2.30:8000
# Memory cap per service container (compose reads it; 1g runs the measured workloads).
DBIG_MEM_LIMIT=1g
# --- secrets are files under deploy/secrets/, never values here -------------------------------
# caller-keys-<service>.json      per-caller keys and scopes (decision 16)
# scan-signing.key                signs scan requests
# token.key                       signs snapshot tokens
# sources/<source_id>.json        one JSON login per database in sources.toml (owner decision 5:
#                                 read-only accounts, added by the owner)
# source-ca-bundle.pem            the CA for databases with tls = true (an empty file when none)
# model.key                       the vLLM bearer token
# langfuse-public.key             the Langfuse project public key
# langfuse-secret.key             the Langfuse project secret key
# requester-collector-token       the bearer the requester sends to the collector HTTP adapter
# With plain HTTP (decision 14) no TLS certificate files are needed for the five services.
# Nothing in this file is a secret.
