<!-- TLS ports for the ClickHouse stacks (owner ruling D2, 2026-11-11); plaintext ports stay. -->
<clickhouse>
    <https_port>8443</https_port>
    <tcp_port_secure>9440</tcp_port_secure>
    <openSSL>
        <server>
            <certificateFile>/tmp/dbig-server.crt</certificateFile>
            <privateKeyFile>/tmp/dbig-server.key</privateKeyFile>
            <!-- No client certificate is asked for; clients authenticate as before. -->
            <verificationMode>none</verificationMode>
            <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>
</clickhouse>
