# Variables the local run reads, as used in docs/LOCAL_RUN.md. Nothing loads this file
# automatically: set these in the shell you run from. Never commit populated values.

# Signs every bundle in one run and verifies them in assemble/render; at least 32 bytes.
# DBIG_SIGNING_KEY=

# One JSON object per source, named by `connection_env` in its source file.
# PG_CONNECTION={"host": "db1.corp.example", "port": 5432, "database": "app", "user": "dbig_reader", "password": ""}
# CLICKHOUSE_CONNECTION={"host": "ch1.corp.example", "port": 8443, "username": "dbig_reader", "password": ""}
# MONGODB_CONNECTION={"uri": "mongodb://dbig_reader:@mongo1.corp.example:27017/?authSource=appdb"}

# Optional: cross-source value tokens (same key for every source in a run, new key per run).
# DBIG_TOKEN_KEY=

# Optional: the bearer token passed to `vllm serve --api-key`.
# VLLM_API_KEY=

# Any source setting can be overridden per run as DBIG_<SETTING>, e.g. DBIG_MAX_QUERIES=800.
