# Copy to .env. These are non-secret examples; never commit the populated .env.
DBIG_ENV=development
DBIG_CONFIG_PATH=config/local.toml
DBIG_OUTPUT_DIR=artifacts
DBIG_STATE_DIR=.data
DBIG_OLLAMA_URL=http://127.0.0.1:11434
DBIG_OLLAMA_MODEL=qwen3:8b
DBIG_LLM_ENABLED=true
DBIG_LLM_TIMEOUT_SECONDS=30
DBIG_LOG_LEVEL=INFO

# Provide credentials through a secret manager or process environment at runtime.
# DBIG_PG_PASSWORD=
# DBIG_CLICKHOUSE_PASSWORD=
# DBIG_MONGODB_URI=
