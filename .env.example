# Copy to .env. These are non-secret examples; never commit the populated .env.
DBIG_ENV=development
DBIG_CONFIG_PATH=config/local.toml
DBIG_OUTPUT_DIR=artifacts
DBIG_STATE_DIR=.data
DBIG_VLLM_BASE_URL=http://127.0.0.1:8000/v1
DBIG_VLLM_MODEL=replace-with-pinned-local-model-id
# DBIG_VLLM_API_KEY=read-from-secret-manager-or-process-environment
DBIG_LANGFUSE_BASE_URL=http://127.0.0.1:3000
# DBIG_LANGFUSE_PUBLIC_KEY=read-from-secret-manager-or-process-environment
# DBIG_LANGFUSE_SECRET_KEY=read-from-secret-manager-or-process-environment
DBIG_LANGFUSE_ENABLED=false
DBIG_LLM_ENABLED=true
DBIG_LLM_TIMEOUT_SECONDS=30
DBIG_LOG_LEVEL=INFO

# Provide credentials through a secret manager or process environment at runtime.
# DBIG_PG_PASSWORD=
# DBIG_CLICKHOUSE_PASSWORD=
# DBIG_MONGODB_URI=
