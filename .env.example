# Copy to .env (git ignores it), fill in, then load it into the shell you run from:
#
#     cp .env.example .env && chmod 600 .env && $EDITOR .env
#     set -a; . ./.env; set +a
#
# Nothing reads this file by itself: the commands read environment variables, and `set -a`
# exports every variable the file sets. Keep the single quotes around JSON values; a password
# that itself contains a single quote must be written as '\'' inside them. Never commit .env.
# If `. ./.env` fails, docs/LOCAL_RUN.md step 4 shows how to find the malformed line.

# REQUIRED: this one must be filled in. Signs every bundle in one run and verifies them in
# assemble/render; at least 32 bytes. Left empty, `dbig collect` stops with "environment
# variable DBIG_SIGNING_KEY for collector bundle signing is empty".
# Generate one per run: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DBIG_SIGNING_KEY=''

# One JSON object per source, named by `connection_env` in its source file. Use the host name
# the server's TLS certificate names, not its IP address.
PG_CONNECTION='{"host": "db1.corp.example", "port": 5432, "database": "app", "user": "dbig_reader", "password": ""}'
CLICKHOUSE_CONNECTION='{"host": "ch1.corp.example", "port": 8443, "username": "dbig_reader", "password": ""}'
MONGODB_CONNECTION='{"uri": "mongodb://dbig_reader:PASSWORD@mongo1.corp.example:27017/?authSource=appdb"}'

# Optional: cross-source value tokens (same key for every source in a run, new key per run).
# DBIG_TOKEN_KEY=''

# Optional: the bearer token passed to `vllm serve --api-key`, used by assemble and ask.
# VLLM_API_KEY=''

# Optional: bearer tokens for the HTTP services (`dbig-requester serve`, `dbig-planner serve`,
# `dbig serve`) and for scan requests over HTTP.
# REQUESTER_TOKEN=''
# PLANNER_TOKEN=''
# COLLECTOR_TOKEN=''

# Any source setting can be overridden per run as DBIG_<SETTING>, e.g. DBIG_MAX_QUERIES=800.
# Such a variable applies to every source you collect while it is set.
