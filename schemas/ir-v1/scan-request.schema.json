{
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "metadata",
          "sample",
          "history"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "ir_version": {
      "default": "1.0",
      "title": "Ir Version",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "reason": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reply_location": {
      "minLength": 1,
      "title": "Reply Location",
      "type": "string"
    },
    "requester_id": {
      "minLength": 1,
      "title": "Requester Id",
      "type": "string"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scopes",
      "type": "array"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_id",
    "scopes",
    "capabilities",
    "reason",
    "requester_id",
    "idempotency_key",
    "issued_at",
    "expires_at",
    "reply_location"
  ],
  "title": "ScanRequest",
  "type": "object"
}
