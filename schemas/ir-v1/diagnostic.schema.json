{
  "additionalProperties": true,
  "description": "A machine-readable reason the collector could not carry something into the bundle.\n\n`code` is required and constrained so a bundle's diagnostic summary is well defined: the\nper-code counts in the manifest can only add up to the row count if every row has exactly one\nstable code. `message` stays free text for an operator and is never required to parse.",
  "properties": {
    "code": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Code",
      "type": "string"
    },
    "collector_version": {
      "minLength": 1,
      "title": "Collector Version",
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "ir_version": {
      "default": "1.0",
      "title": "Ir Version",
      "type": "string"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provenance": {
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "record_type": {
      "const": "diagnostic",
      "default": "diagnostic",
      "title": "Record Type",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_id",
    "observed_at",
    "collector_version",
    "provenance",
    "code"
  ],
  "title": "Diagnostic",
  "type": "object"
}
